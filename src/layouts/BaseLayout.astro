---
import '../styles/global.css';
import { appFacts, siteUrl, type PageSEO } from '../config/site';

interface Props {
  seo: PageSEO;
}

const { seo } = Astro.props;
const canonical = new URL(seo.canonicalPath, siteUrl).toString();
const socialImage = new URL(seo.image ?? appFacts.socialImage, siteUrl).toString();
const pageTitle = seo.canonicalPath === '/' ? seo.title : `${seo.title} | ${appFacts.name}`;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={seo.description} />
    <meta name="robots" content={seo.indexing ?? 'index,follow'} />
    <meta name="theme-color" content="#fffaf1" />
    <meta name="apple-itunes-app" content="app-id=6569254568" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/assets/appicon.png" />
    <link rel="apple-touch-icon" href="/assets/appicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={appFacts.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="House Manager — home maintenance, inventory, warranties, and projects in one place" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="House Manager — home maintenance, inventory, warranties, and projects in one place" />
    {
      seo.structuredData?.map((entry) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(entry)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>

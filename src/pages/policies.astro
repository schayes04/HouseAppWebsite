---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { appFacts, breadcrumbSchema, type PageSEO } from '../config/site';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Policies', path: '/policies/' },
] as const;

const seo: PageSEO = {
  title: 'Privacy Policy and Terms of Use',
  description: 'Read the House Manager Privacy Policy and Terms of Use, including data practices and premium subscription terms.',
  canonicalPath: '/policies/',
  breadcrumbs,
  structuredData: [breadcrumbSchema(breadcrumbs)],
};
---

<BaseLayout {seo}>
  <SiteHeader currentPath="/policies/" />
  <main id="main-content">
    <Breadcrumbs items={breadcrumbs} />
    <article class="legal-content">
      <header>
        <p class="eyebrow">House Manager policies</p>
        <h1>Privacy Policy &amp; Terms of Use</h1>
      </header>

      <section aria-labelledby="privacy-heading">
        <h2 id="privacy-heading">Privacy Policy</h2>
        <p><strong>Last updated</strong>: August 28, 2026</p>

        <p><strong>House Manager</strong> ("we," "our," or "us") is developed by <strong>Shayes Apps</strong> and is designed to help users manage household-related tasks and projects. This Privacy Policy outlines how we collect, use, and share personal information when you use House Manager.</p>

        <h3>1. Information We Collect</h3>
        <p>We use Firebase by Google and RevenueCat to store and manage data and subscriptions. These platforms may collect certain information to improve our app's functionality. The types of data collected include:</p>
        <ul>
          <li><strong>Personal Information</strong>: When you create an account or interact with certain features, we collect data such as your username, email address, and any other optional details you provide.</li>
          <li><strong>App Usage Data</strong>: Information about how you interact with the app, including device information, IP addresses, and crash reports, to enhance performance.</li>
          <li><strong>Push Notification Tokens</strong>: Stored securely to deliver timely notifications.</li>
          <li><strong>Subscription and Purchase Data</strong>: RevenueCat processes subscription and in-app purchase data to manage billing and ensure accurate access to premium features.</li>
        </ul>

        <h3>2. How We Use Your Information</h3>
        <p>We use collected information to:</p>
        <ul>
          <li>Operate and improve the app's functionality.</li>
          <li>Send notifications for due tasks based on user preferences.</li>
          <li>Analyze app usage to enhance user experience.</li>
          <li>Manage subscriptions and in-app purchases via RevenueCat.</li>
        </ul>

        <h3>3. How We Share Your Information</h3>
        <p>We do not share personal data with third parties unless required by law or to comply with legal processes. Firebase and RevenueCat may process data as third-party processors to enable our services.</p>
        <p>By using our app and making in-app purchases, you consent to our sharing of data regarding your usage and consumption of purchased content with Apple, as part of our efforts to resolve refund requests. This information may include details about how you have accessed and interacted with the purchased content. The purpose of sharing this data is to help Apple make an informed decision regarding refund requests. We ensure that such data sharing is done in compliance with Apple's policies and only as necessary to process your requests.</p>

        <h3>4. Data Security</h3>
        <p>We are committed to protecting your information. Data is stored securely within Firebase and RevenueCat, which use robust security measures to prevent unauthorized access.</p>

        <h3>5. Your Rights and Choices</h3>
        <p>You have the right to access, correct, or delete your information. The app includes an option for users to delete their data. You can also contact us directly at <a href={appFacts.supportEmailUrl}>{appFacts.supportAddress}</a> to exercise these rights.</p>

        <h3>6. Changes to This Privacy Policy</h3>
        <p>We may update this Privacy Policy from time to time. The “Last updated” date will reflect the latest revision date.</p>
      </section>

      <section aria-labelledby="terms-heading">
        <h2 id="terms-heading">Terms of Use</h2>
        <p><strong>Last updated</strong>: August 28, 2026</p>

        <h3>Premium Subscription Terms</h3>
        <p>Subscriptions will automatically renew unless canceled within 24-hours before the end of the current period. You can cancel anytime through the platform you purchased from. Any unused portion of a free trial will be forfeited if you purchase a subscription. Subscription and billing management is powered by RevenueCat.</p>
      </section>

      <section aria-labelledby="contact-heading">
        <h2 id="contact-heading">Contact Us</h2>
        <p>For questions regarding our Privacy Policy or Terms of Use, please contact us at:</p>
        <p>Email: <a href={appFacts.supportEmailUrl}>{appFacts.supportAddress}</a></p>
      </section>
    </article>
  </main>
  <SiteFooter />
</BaseLayout>
